# User boards and routing exports are local working data.
*.dsn
*.DSN
*.ses
*.SES
*-routed.*
*-checks.json
*-report.json
*.log
job-*/
jobs/
results/
outputs/
benchmark-output/
data/
board.json
status.json
drc.json
width-check.json
stop.flag

# Keep intentionally committed original examples and test fixtures.
!examples/**/*.dsn
!examples/**/*.DSN
!fixtures/**/*.dsn
!fixtures/**/*.DSN
!fixtures/**/*.ses
!fixtures/**/*.SES

# Developer dependencies, local browser files and OS metadata.
node_modules/
package-lock.json
playwright-report/
test-results/
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
Desktop.ini
